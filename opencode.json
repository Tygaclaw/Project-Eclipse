{
  "$schema": "https://opencode.ai/config.json",
  "model": "tokenharbor/deepseek-v4.1-flash:free",
  "provider": {
    "tokenharbor": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Token Harbor",
      "options": {
        "baseURL": "https://tokenharbor.ai/v1",
        "apiKey": "{env:TOKENHARBOR_API_KEY}"
      },
      "models": {
        "deepseek-v4.1-flash:free": {
          "name": "DeepSeek V4.1 Flash (Token Harbor Free)",
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        },
        "mimo-v2.6-flash:free": {
          "name": "MiMo V2.6 Flash (Token Harbor Free)",
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        }
      }
    },
    "google": {
      "models": {
        "gemini-3.8-flash": {
          "name": "Gemini 3.8 Flash",
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        },
        "gemini-3.7-flash": {
          "name": "Gemini 3.7 Flash",
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        }
      }
